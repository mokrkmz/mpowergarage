  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    :root {
      --m-blue: #0066B1;
      --m-navy: #003D78;
      --m-red: #E22718;
      --m-light-blue: #81C4FF;
      --dark: #f4f8fd;
      --dark2: #ffffff;
      --dark3: #e8f1fa;
      --dark4: #dceaf6;
      --border: rgba(0,61,120,0.12);
      --text: #0d1f35;
      --muted: #4a6080;
      --stripe-height: 4px;
      --font-display: 'Barlow Condensed', sans-serif;
      --font-body: 'Barlow', sans-serif;
    }


    .hero-car {
      position: absolute;
      right: -20px;
      bottom: 60px;
      width: 55%;
      max-width: 680px;
      opacity: 0.92;
      pointer-events: none;
    }
    @media (max-width: 900px) {
      .hero-car {
        position: relative;
        width: 100%;
        right: auto;
        bottom: auto;
        margin-top: 2rem;
        opacity: 0.85;
      }
    }
    @media (max-width: 600px) {
      .hero-car { display: none; }
    }

    html { scroll-behavior: smooth; }
    body { font-family: var(--font-body); background: #f4f8fd; color: var(--text); overflow-x: hidden; }

    /* M STRIPE — signature 3-color stripe */
    .m-stripe {
      height: var(--stripe-height);
      background: linear-gradient(90deg, var(--m-navy) 33.3%, var(--m-blue) 33.3% 66.6%, var(--m-red) 66.6%);
    }

    /* NAV */
    nav {
      position: sticky; top: 0; z-index: 100;
      background: rgba(244,248,253,0.97);
      backdrop-filter: blur(8px);
      border-bottom: 1px solid rgba(0,61,120,0.15);
    }
    .nav-inner {
      max-width: 1200px; margin: 0 auto;
      display: flex; justify-content: space-between; align-items: center;
      padding: 0 2rem; height: 64px;
    }
    .logo {
      font-family: var(--font-display);
      font-size: 22px; font-weight: 700;
      letter-spacing: 0.12em; color: var(--text);
      text-decoration: none;
      display: flex; align-items: center; gap: 10px;
    }
    .logo-badge {
      display: flex; gap: 3px;
    }
    .logo-badge span {
      display: block; width: 6px; height: 18px; border-radius: 1px;
    }
    .logo-badge span:nth-child(1) { background: var(--m-navy); }
    .logo-badge span:nth-child(2) { background: var(--m-blue); }
    .logo-badge span:nth-child(3) { background: var(--m-red); }
    .logo-text { letter-spacing: 0.08em; }
    .logo-text em { font-style: normal; color: var(--m-blue); }

    .nav-links {
      display: flex; gap: 2.5rem; list-style: none;
    }
    .nav-links a {
      font-family: var(--font-display);
      font-size: 13px; font-weight: 500;
      letter-spacing: 0.12em; color: var(--muted);
      text-decoration: none; transition: color 0.2s;
    }
    .nav-links a:hover { color: var(--text); }
    .nav-links a.cta {
      color: var(--m-red); border: 1px solid rgba(226,39,24,0.4);
      padding: 6px 16px; border-radius: 2px;
    }
    .nav-links a.cta:hover { background: var(--m-red); color: #fff; }

    .hamburger {
      display: none; flex-direction: column; gap: 5px;
      cursor: pointer; padding: 4px;
    }
    .hamburger span { display: block; width: 24px; height: 2px; background: var(--text); transition: all 0.3s; }

    .mobile-menu {
      display: none; flex-direction: column;
      background: #ffffff; border-bottom: 1px solid rgba(0,61,120,0.15);
      padding: 1rem 2rem;
    }
    .mobile-menu.open { display: flex; }
    .mobile-menu a {
      font-family: var(--font-display);
      font-size: 16px; letter-spacing: 0.1em; color: var(--muted);
      text-decoration: none; padding: 12px 0;
      border-bottom: 1px solid var(--border);
    }
    .mobile-menu a:hover { color: var(--text); }
    .mobile-menu a:last-child { border-bottom: none; color: var(--m-red); }

    /* SECTIONS */
    section { display: none; }
    section.active { display: block; }

    /* HERO */
    .hero {
      min-height: calc(100vh - 68px);
      display: grid; grid-template-rows: 1fr auto;
      background: url('data:image/jpeg;base64,') center center / cover no-repeat;
      position: relative; overflow: hidden;
    }
    .hero::before {
      content: '';
      position: absolute; top: 0; left: 0; right: 0; bottom: 0;
      background: linear-gradient(135deg, rgba(0,15,35,0.88) 0%, rgba(0,40,80,0.72) 50%, rgba(0,20,50,0.65) 100%);
      z-index: 1;
    }
    .hero > * {
      position: relative;
      z-index: 2;
    }
    .hero-content {
      display: flex; flex-direction: column; justify-content: center;
      padding: 5rem 2rem 4rem 4rem;
      max-width: 620px; margin: 0; width: 100%;
    }
    .hero-eyebrow {
      font-family: var(--font-display);
      font-size: 11px; letter-spacing: 0.3em; color: var(--m-light-blue);
      margin-bottom: 1.5rem; display: flex; align-items: center; gap: 12px;
    }
    .hero-eyebrow::before {
      content: ''; display: block; width: 32px; height: 2px; background: var(--m-blue);
    }
    .hero h1 {
      font-family: var(--font-display);
      font-size: clamp(52px, 9vw, 110px);
      font-weight: 700; line-height: 0.95;
      letter-spacing: -0.01em;
      max-width: 700px;
      color: #ffffff;
      text-shadow: 0 2px 20px rgba(0,0,0,0.4);
    }
    .hero h1 .line-red { color: var(--m-red); }
    .hero h1 .line-blue { color: var(--m-blue); }
    .hero-sub {
      font-size: 16px; color: rgba(255,255,255,0.75); max-width: 420px;
      line-height: 1.75; margin: 2rem 0;
    }
    .hero-btns { display: flex; gap: 12px; flex-wrap: wrap; }
    .btn-red {
      font-family: var(--font-display);
      font-size: 12px; font-weight: 600; letter-spacing: 0.15em;
      background: var(--m-red); color: #fff;
      border: none; padding: 14px 32px;
      cursor: pointer; border-radius: 2px; transition: background 0.2s;
      text-decoration: none; display: inline-block;
    }
    .btn-red:hover { background: #c41e0e; }
    .btn-outline {
      font-family: var(--font-display);
      font-size: 12px; font-weight: 600; letter-spacing: 0.15em;
      background: transparent; color: #ffffff;
      border: 1px solid rgba(255,255,255,0.4); padding: 14px 32px;
      cursor: pointer; border-radius: 2px; transition: border-color 0.2s;
      text-decoration: none; display: inline-block;
    }
    .btn-outline:hover { border-color: #fff; }

    .hero-bg-text {
      position: absolute; right: -2%; bottom: -5%;
      font-family: var(--font-display);
      font-size: clamp(120px, 18vw, 220px); font-weight: 700;
      color: rgba(0,61,120,0.04); letter-spacing: -0.02em;
      user-select: none; pointer-events: none; line-height: 1;
    }
    .hero-accent {
      position: absolute; top: 0; right: 0;
      width: 40%; height: 100%;
      background: linear-gradient(135deg, transparent 50%, rgba(0,102,177,0.12) 100%);
      pointer-events: none;
      z-index: 1;
    }

    /* STATS */
    .stats-row {
      display: grid; grid-template-columns: repeat(3, 1fr);
      border-top: 1px solid rgba(255,255,255,0.1);
      max-width: 100%;
      background: rgba(8,20,45,0.85);
    }
    .stat-item {
      padding: 2rem 3rem;
      border-right: 1px solid rgba(255,255,255,0.1);
    }
    .stat-item:last-child { border-right: none; }
    .stat-num {
      font-family: var(--font-display);
      font-size: 44px; font-weight: 700; color: var(--m-blue);
      line-height: 1;
    }
    .stat-label {
      font-family: var(--font-display);
      font-size: 11px; letter-spacing: 0.15em; color: rgba(255,255,255,0.5);
      margin-top: 6px;
    }

    /* PAGE SECTIONS */
    .page-wrap { max-width: 1200px; margin: 0 auto; padding: 5rem 2rem; }
    .section-eyebrow {
      font-family: var(--font-display);
      font-size: 11px; letter-spacing: 0.25em; color: var(--m-blue);
      display: flex; align-items: center; gap: 10px; margin-bottom: 1rem;
    }
    .section-eyebrow::before { content: ''; width: 24px; height: 2px; background: var(--m-blue); display: block; }
    .section-title {
      font-family: var(--font-display);
      font-size: clamp(32px, 5vw, 52px); font-weight: 700;
      line-height: 1; margin-bottom: 1rem;
    }
    .section-sub { font-size: 15px; color: var(--muted); max-width: 480px; line-height: 1.75; margin-bottom: 3rem; }

    /* SERVICES */
    .services-grid {
      display: grid; grid-template-columns: repeat(3, 1fr);
      gap: 1px; background: var(--border);
    }
    .service-card {
      background: var(--dark2); padding: 2.5rem 2rem;
      transition: background 0.25s;
      position: relative; overflow: hidden;
    }
    .service-card::after {
      content: ''; position: absolute; top: 0; left: 0; right: 0;
      height: 3px; background: linear-gradient(90deg, var(--m-navy), var(--m-blue), var(--m-red));
      transform: scaleX(0); transform-origin: left; transition: transform 0.3s;
    }
    .service-card:hover { background: #dceaf6; }
    .service-card:hover::after { transform: scaleX(1); }
    .service-num {
      font-family: var(--font-display);
      font-size: 11px; letter-spacing: 0.2em; color: var(--m-blue);
      margin-bottom: 1.5rem;
    }
    .service-card h3 {
      font-family: var(--font-display);
      font-size: 20px; font-weight: 600; margin-bottom: 0.75rem;
    }
    .service-card p { font-size: 13px; color: var(--muted); line-height: 1.7; }

    /* PRICING */
    .pricing-grid {
      display: grid; grid-template-columns: repeat(3, 1fr);
      gap: 1px; background: var(--border);
    }
    .price-card { background: var(--dark2); padding: 2.5rem 2rem; }
    .price-card.featured {
      background: #dceaf6;
      position: relative;
    }
    .featured-tag {
      font-family: var(--font-display);
      font-size: 10px; letter-spacing: 0.2em;
      background: var(--m-red); color: #fff;
      padding: 4px 12px; border-radius: 2px;
      display: inline-block; margin-bottom: 1rem;
    }
    .price-tier {
      font-family: var(--font-display);
      font-size: 11px; letter-spacing: 0.2em; color: var(--muted);
      margin-bottom: 0.5rem;
    }
    .price-card h3 {
      font-family: var(--font-display);
      font-size: 26px; font-weight: 700; margin-bottom: 0.5rem;
    }
    .price-amount {
      font-family: var(--font-display);
      font-size: 36px; font-weight: 700; color: var(--m-blue);
      margin-bottom: 2rem;
    }
    .price-amount span { font-size: 14px; color: var(--muted); font-weight: 400; }
    .price-list { list-style: none; font-size: 13px; color: var(--muted); }
    .price-list li {
      padding: 8px 0; border-bottom: 1px solid var(--border);
      display: flex; align-items: center; gap: 10px;
    }
    .price-list li::before {
      content: ''; display: block; width: 6px; height: 6px;
      background: var(--m-blue); border-radius: 50%; flex-shrink: 0;
    }
    .price-list li:last-child { border-bottom: none; }

    /* GALLERY */
    .gallery-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      grid-template-rows: repeat(2, 220px);
      gap: 2px;
    }
    .gallery-item {
      background: var(--dark3);
      position: relative; overflow: hidden;
      display: flex; align-items: flex-end;
      cursor: pointer;
    }
    .gallery-item:first-child { grid-column: span 2; }
    .gallery-fill {
      position: absolute; inset: 0;
      transition: transform 0.4s ease;
    }
    .gallery-item:hover .gallery-fill { transform: scale(1.04); }
    .g1 .gallery-fill { background: linear-gradient(135deg, #c8dff5 0%, #a8c8ee 100%); }
    .g2 .gallery-fill { background: linear-gradient(135deg, #dce8f5 0%, #b8d0ec 100%); }
    .g3 .gallery-fill { background: linear-gradient(135deg, #c0d8f0 0%, #a0c0e8 100%); }
    .g4 .gallery-fill { background: linear-gradient(135deg, #d4e8f8 0%, #b0d0f0 100%); }
    .g5 .gallery-fill { background: linear-gradient(135deg, #c8e0f5 0%, #a8c8ec 100%); }
    .gallery-label {
      position: relative; z-index: 2;
      padding: 16px 20px;
      font-family: var(--font-display);
      font-size: 11px; letter-spacing: 0.18em; color: var(--m-navy);
      background: linear-gradient(transparent, rgba(0,0,0,0.5));
      width: 100%;
    }

    /* ABOUT */
    .about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: start; }
    .about-text p {
      font-size: 15px; color: var(--muted); line-height: 1.85; margin-bottom: 1.25rem;
    }
    .values-grid {
      display: grid; grid-template-columns: 1fr 1fr;
      gap: 1px; background: var(--border); margin-top: 2.5rem;
    }
    .value-item { background: var(--dark2); padding: 1.5rem; }
    .value-item h4 {
      font-family: var(--font-display);
      font-size: 14px; font-weight: 600; letter-spacing: 0.08em;
      color: var(--m-blue); margin-bottom: 6px;
    }
    .value-item p { font-size: 12px; color: var(--muted); line-height: 1.6; }

    .about-visual-block {
      position: sticky; top: 80px;
    }
    .about-big-text {
      font-family: var(--font-display);
      font-size: clamp(80px, 12vw, 140px);
      font-weight: 700; line-height: 0.85;
      background: linear-gradient(135deg, var(--m-navy), var(--m-blue) 50%, rgba(226,39,24,0.6));
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      background-clip: text;
      margin-bottom: 2rem;
    }
    .cert-row { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 2rem; }
    .cert-badge {
      font-family: var(--font-display);
      font-size: 10px; letter-spacing: 0.15em;
      border: 1px solid rgba(0,61,120,0.2); color: var(--m-navy);
      padding: 8px 14px; border-radius: 2px;
    }

    /* CONTACT */
    .contact-grid { display: grid; grid-template-columns: 1fr 1.4fr; gap: 5rem; align-items: start; }
    .contact-details { display: flex; flex-direction: column; gap: 2rem; }
    .contact-item h4 {
      font-family: var(--font-display);
      font-size: 10px; letter-spacing: 0.25em; color: var(--m-blue);
      margin-bottom: 8px;
    }
    .contact-item p { font-size: 14px; color: var(--muted); line-height: 1.8; }
    .hours-row { display: flex; justify-content: space-between; font-size: 13px; padding: 6px 0; border-bottom: 1px solid var(--border); }
    .hours-row:last-child { border-bottom: none; }
    .hours-day { color: var(--muted); }
    .hours-time { color: var(--text); }
    .hours-closed { color: var(--m-red); }

    .contact-form { display: flex; flex-direction: column; gap: 1rem; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .form-group { display: flex; flex-direction: column; gap: 6px; }
    .form-group label {
      font-family: var(--font-display);
      font-size: 10px; letter-spacing: 0.2em; color: var(--muted);
    }
    .form-group input,
    .form-group select,
    .form-group textarea {
      background: var(--dark3); border: 1px solid var(--border);
      color: var(--text); padding: 12px 14px;
      font-size: 14px; font-family: var(--font-body);
      border-radius: 2px; outline: none;
      transition: border-color 0.2s;
    }
    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus { border-color: var(--m-blue); }
    .form-group select option { background: var(--dark2); }
    .form-group textarea { min-height: 110px; resize: vertical; }
    .form-submit {
      font-family: var(--font-display);
      font-size: 12px; font-weight: 600; letter-spacing: 0.15em;
      background: var(--m-red); color: #fff;
      border: none; padding: 16px;
      cursor: pointer; border-radius: 2px;
      transition: background 0.2s; width: 100%;
    }
    .form-submit:hover { background: #c41e0e; }
    .form-note { font-size: 12px; color: var(--muted); text-align: center; margin-top: 4px; }

    /* FOOTER */
    footer {
      border-top: 1px solid var(--border);
      background: #e8f1fa;
    }
    .footer-inner {
      max-width: 1200px; margin: 0 auto;
      padding: 3rem 2rem 2rem;
      display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 3rem;
    }
    .footer-brand p { font-size: 13px; color: var(--muted); line-height: 1.8; margin-top: 1rem; max-width: 280px; }
    .footer-col h4 {
      font-family: var(--font-display);
      font-size: 11px; letter-spacing: 0.18em; color: var(--text);
      margin-bottom: 1rem;
    }
    .footer-col a {
      display: block; font-size: 13px; color: var(--muted);
      text-decoration: none; padding: 4px 0; transition: color 0.2s;
    }
    .footer-col a:hover { color: var(--text); }
    .footer-bottom {
      max-width: 1200px; margin: 0 auto;
      padding: 1.5rem 2rem;
      border-top: 1px solid var(--border);
      display: flex; justify-content: space-between; align-items: center;
      flex-wrap: wrap; gap: 1rem;
    }
    .footer-bottom p { font-size: 12px; color: #444; }

    /* RESPONSIVE */
    @media (max-width: 900px) {
      .nav-links { display: none; }
      .hamburger { display: flex; }
      .services-grid { grid-template-columns: repeat(2, 1fr); }
      .pricing-grid { grid-template-columns: 1fr; gap: 1px; }
      .gallery-grid { grid-template-columns: 1fr 1fr; grid-template-rows: repeat(3, 200px); }
      .gallery-item:first-child { grid-column: span 2; }
      .about-grid { grid-template-columns: 1fr; gap: 3rem; }
      .about-visual-block { position: static; }
      .contact-grid { grid-template-columns: 1fr; gap: 3rem; }
      .footer-inner { grid-template-columns: 1fr 1fr; }
      .footer-brand { grid-column: span 2; }
      .stats-row { grid-template-columns: 1fr; }
      .stat-item { border-right: none; border-bottom: 1px solid var(--border); }
      .stat-item:last-child { border-bottom: none; }
    }
    @media (max-width: 600px) {
      .services-grid { grid-template-columns: 1fr; }
      .gallery-grid { grid-template-columns: 1fr; grid-template-rows: auto; }
      .gallery-item { height: 180px; }
      .gallery-item:first-child { grid-column: span 1; }
      .form-row { grid-template-columns: 1fr; }
      .hero-content { padding: 3rem 1.5rem; }
      .page-wrap { padding: 3rem 1.5rem; }
      .stat-item { padding: 1.5rem 1.5rem; }
      .footer-inner { grid-template-columns: 1fr; gap: 2rem; }
      .footer-brand { grid-column: span 1; }
      .about-big-text { font-size: 80px; }
      .values-grid { grid-template-columns: 1fr; }
      .modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,0.7);z-index:999;display:none;align-items:center;justify-content:center}
.modal-overlay.open{display:flex}
.modal-box{background:#fff;max-width:600px;width:90%;border-radius:4px;overflow:hidden;max-height:90vh;overflow-y:auto}
.modal-box img{width:100%;height:220px;object-fit:cover}
.modal-body{padding:2rem}
.modal-body h2{color:#003D78;margin-bottom:1rem}
.modal-body p{color:#444;line-height:1.8;margin-bottom:1rem}
.modal-close{float:right;background:none;border:none;font-size:24px;cursor:pointer;color:#333}
    }
  </style>
